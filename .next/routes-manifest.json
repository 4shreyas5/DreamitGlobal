{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/admin/properties/[id]",
      "regex": "^/admin/properties/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/admin/properties/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/country/[code]",
      "regex": "^/country/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcode": "nxtPcode"
      },
      "namedRegex": "^/country/(?<nxtPcode>[^/]+?)(?:/)?$"
    },
    {
      "page": "/properties/[slug]",
      "regex": "^/properties/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/properties/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[city]",
      "regex": "^/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcity": "nxtPcity"
      },
      "namedRegex": "^/(?<nxtPcity>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[city]/[slug]",
      "regex": "^/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcity": "nxtPcity",
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/(?<nxtPcity>[^/]+?)/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
